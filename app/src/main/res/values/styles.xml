<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="md_theme_surfaceContainer">#DCE4EF</color>
    <color name="md_theme_keySurface">#FFFFFF</color>
    <color name="md_theme_actionSurface">#C8DDFC</color>
    <color name="md_theme_primary">#0B57D0</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_onPrimaryContainer">#052354</color>
    <color name="md_theme_onSurface">#1A1C1E</color>
    <color name="md_theme_onSurfaceVariant">#5A6270</color>

    <style name="NumpadStripImageButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="NumpadKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal|center_vertical</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_numpad_key</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NumpadActionKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">0.85</item>
        <item name="android:layout_gravity">fill_horizontal|center_vertical</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:background">@drawable/bg_numpad_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/md_theme_onPrimaryContainer</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NumpadActionImageKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">0.85</item>
        <item name="android:layout_gravity">fill_horizontal|center_vertical</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">@drawable/bg_numpad_action</item>
    </style>

    <style name="NumpadSecondaryKey" parent="NumpadActionKey">
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="NumpadEnterImageKey" parent="NumpadActionImageKey">
        <item name="android:background">@drawable/bg_numpad_enter</item>
    </style>

    <style name="NumpadDigit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NumpadLetters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
