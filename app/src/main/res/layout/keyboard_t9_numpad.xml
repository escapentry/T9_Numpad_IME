<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md_theme_surfaceContainer"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="10dp">

    <!-- Gboard Suggestion Strip + Settings Button -->
    <LinearLayout
        android:id="@+id/strip_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_ime_settings"
            style="@style/NumpadStripButton"
            android:text="⚙" />
    </LinearLayout>

    <!-- 4-Column Gboard Numpad Grid (Cols 1-3 = 12-key T9, Col 4 = Thumb Rail) -->
    <GridLayout
        android:id="@+id/numpad_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:useDefaultMargins="false">

        <!-- ROW 1: 1 | 2 | 3 | Mode -->
        <LinearLayout android:id="@+id/key_1" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="1" />
            <TextView style="@style/NumpadLetters" android:text=".,?!" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_2" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="2" />
            <TextView style="@style/NumpadLetters" android:text="ABC" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_3" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="3" />
            <TextView style="@style/NumpadLetters" android:text="DEF" />
        </LinearLayout>

        <Button android:id="@+id/key_mode" style="@style/NumpadActionKey" android:text="T9" />

        <!-- ROW 2: 4 | 5 | 6 | Symbols -->
        <LinearLayout android:id="@+id/key_4" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="4" />
            <TextView style="@style/NumpadLetters" android:text="GHI" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_5" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="5" />
            <TextView style="@style/NumpadLetters" android:text="JKL" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_6" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="6" />
            <TextView style="@style/NumpadLetters" android:text="MNO" />
        </LinearLayout>

        <Button android:id="@+id/key_sym" style="@style/NumpadActionKey" android:text="@#&amp;" />

        <!-- ROW 3: 7 | 8 | 9 | Backspace -->
        <LinearLayout android:id="@+id/key_7" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="7" />
            <TextView style="@style/NumpadLetters" android:text="PQRS" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_8" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="8" />
            <TextView style="@style/NumpadLetters" android:text="TUV" />
        </LinearLayout>

        <LinearLayout android:id="@+id/key_9" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="9" />
            <TextView style="@style/NumpadLetters" android:text="WXYZ" />
        </LinearLayout>

        <Button android:id="@+id/key_backspace" style="@style/NumpadActionKey" android:text="⌫" />

        <!-- ROW 4: * | 0 | # | Enter -->
        <Button android:id="@+id/key_star" style="@style/NumpadSecondaryKey" android:text="* ⇧" />

        <LinearLayout android:id="@+id/key_0" style="@style/NumpadKey">
            <TextView style="@style/NumpadDigit" android:text="0" />
            <TextView style="@style/NumpadLetters" android:text="␣ +" />
        </LinearLayout>

        <Button android:id="@+id/key_hash" style="@style/NumpadSecondaryKey" android:text="# ↻" />

        <Button android:id="@+id/key_enter" style="@style/NumpadEnterKey" android:text="↵" />

    </GridLayout>

    <!-- 3-Page Symbols Overlay Panel -->
    <LinearLayout
        android:id="@+id/symbols_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/symbols_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sym_back"
                style="@style/NumpadActionKey"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Back" />

            <Button
                android:id="@+id/btn_sym_page"
                style="@style/NumpadSecondaryKey"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Page 1/3" />

            <Button
                android:id="@+id/btn_sym_space"
                style="@style/NumpadSecondaryKey"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="␣" />

            <Button
                android:id="@+id/btn_sym_backspace"
                style="@style/NumpadActionKey"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⌫" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
