<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T9 Numpad IME Settings"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="1. Enable IME" />

            <Button
                android:id="@+id/btn_switch_ime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="2. Select IME" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Keyboard Theme"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/rb_theme_light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Material Light" />
            <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Material Dark" />
            <RadioButton android:id="@+id/rb_theme_amoled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AMOLED Black" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keyboard Height"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_height_compact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="Compact" />
            <RadioButton android:id="@+id/rb_height_standard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="Standard" />
            <RadioButton android:id="@+id/rb_height_tall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tall" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Typing &amp; Correction"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sound on keypress" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_haptic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haptic vibration on keypress" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_cap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-capitalization" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_space"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-spacing after punctuation &amp; candidates" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_correct_abc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-correct (when T9 is OFF / ABC mode only)" />

    </LinearLayout>
</ScrollView>
